<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>LoginZju</RootNamespace>
    <AssemblyName>login-ZJU.NET</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>login-ZJU.NET</PackageId>
    <Version>0.1.0</Version>
    <Authors>XmmShp</Authors>
    <Description>A lightweight .NET library for authenticating with ZJU (Zhejiang University) services. Ported from the original TypeScript login-ZJU by 5dbwat4.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/XmmShp/login-ZJU.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/XmmShp/login-ZJU.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ZJU;authentication;login;zhejiang-university</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © 2026 XmmShp. Original work Copyright © 2024 5dbwat4.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../THIRD-PARTY-NOTICES" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
